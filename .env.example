# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/surveynext?schema=public"

# Secreto para firmar los JWT de sesión (genera uno con: openssl rand -hex 32)
JWT_SECRET=""

# URL base de la API (vacío = mismo origen)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Orígenes permitidos para CORS, separados por comas (opcional; si se omite se usan los de lib/cors.ts)
# ALLOWED_ORIGINS="http://localhost:3000,https://surveys.intermaritime.org"

# Usuario administrador que crea `npm run seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
